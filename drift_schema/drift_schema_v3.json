  "fixed_sql": [
    {
      "name": "AppBmf",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"AppBmf\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"subject\" INTEGER NOT NULL UNIQUE, \"title\" TEXT NULL DEFAULT '', \"download\" TEXT NULL, \"airDate\" TEXT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "AppSubscription",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"AppSubscription\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"bmfId\" INTEGER NOT NULL REFERENCES AppBmf (id) ON DELETE CASCADE, \"provider\" TEXT NOT NULL DEFAULT 'generic', \"url\" TEXT NOT NULL, \"feedKey\" TEXT NOT NULL, \"sourceConfig\" TEXT NOT NULL DEFAULT '{\"version\":1}' CHECK(json_valid(sourceConfig) AND json_type(sourceConfig) = 'object'), \"autoUpdate\" INTEGER NOT NULL DEFAULT 1 CHECK(autoUpdate IN (0, 1)), \"status\" TEXT NOT NULL DEFAULT 'active' CHECK(status IN ('active', 'needsReview')), \"pendingItems\" TEXT NOT NULL DEFAULT '[]' CHECK(json_valid(pendingItems) AND json_type(pendingItems) = 'array'), \"knownItems\" TEXT NOT NULL DEFAULT '[]' CHECK(json_valid(knownItems) AND json_type(knownItems) = 'array'), \"hasBaseline\" INTEGER NOT NULL DEFAULT 0 CHECK(hasBaseline IN (0, 1)), \"itemKeyVersion\" INTEGER NOT NULL DEFAULT 1 CHECK(itemKeyVersion > 0), UNIQUE (\"bmfId\", \"feedKey\"));"
        }
      ]
    },
    {
      "name": "AppRssCache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"AppRssCache\" (\"feedKey\" TEXT NOT NULL, \"requestUrl\" TEXT NOT NULL, \"data\" TEXT NULL, \"ttlMinutes\" INTEGER NOT NULL DEFAULT 0 CHECK(ttlMinutes >= 0), \"lastSuccessAt\" INTEGER NOT NULL DEFAULT 0 CHECK(lastSuccessAt >= 0), \"lastAttemptAt\" INTEGER NOT NULL DEFAULT 0 CHECK(lastAttemptAt >= 0), \"lastFailedAt\" INTEGER NOT NULL DEFAULT 0 CHECK(lastFailedAt >= 0), \"cacheVersion\" INTEGER NOT NULL DEFAULT 1 CHECK(cacheVersion > 0), PRIMARY KEY (\"feedKey\"));"
        }
      ]
    },
    {
      "name": "AppMigrationRecovery",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"AppMigrationRecovery\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"migrationVersion\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"legacyKey\" TEXT NOT NULL, \"payload\" TEXT NOT NULL CHECK(json_valid(payload) AND json_type(payload) = 'object'), \"candidateBmfIds\" TEXT NOT NULL DEFAULT '[]' CHECK(json_valid(candidateBmfIds) AND json_type(candidateBmfIds) = 'array'), \"createdAt\" INTEGER NOT NULL, \"resolvedAt\" INTEGER NULL, UNIQUE (\"migrationVersion\", \"kind\", \"legacyKey\"));"
        }
      ]
    },
    {
      "name": "AppConfig",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"AppConfig\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "AppPlayback",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"AppPlayback\" (\"pathKey\" TEXT NOT NULL, \"filePath\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"subject\" INTEGER NULL, \"positionMs\" INTEGER NOT NULL DEFAULT 0, \"durationMs\" INTEGER NOT NULL DEFAULT 0, \"completed\" INTEGER NOT NULL DEFAULT 0, \"updatedAt\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"pathKey\"));"
        }
      ]
    },
