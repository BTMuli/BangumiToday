    {
      "name": "BangumiCollection",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"BangumiCollection\" (\"subjectId\" INTEGER NOT NULL, \"subjectType\" INTEGER NOT NULL, \"rate\" INTEGER NOT NULL, \"collectionType\" INTEGER NOT NULL, \"comment\" TEXT NULL, \"tags\" TEXT NOT NULL, \"epStat\" INTEGER NOT NULL, \"volStat\" INTEGER NOT NULL, \"updatedAt\" TEXT NOT NULL, \"private\" INTEGER NOT NULL, \"subject\" TEXT NULL, \"name\" TEXT NOT NULL DEFAULT '', \"nameCn\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"subjectId\"));"
